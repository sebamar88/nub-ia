      "^opencode/claude-sonnet-\\d",
      "^(github-copilot|openai-codex|openai|opencode)/gpt-6(\\.\\d+)?-sol$",
      "^(github-copilot|openai-codex|openai|opencode)/gpt-5\\.6-terra$",
      "^nvidia/nvidia/nemotron-3-super-\\d",
      "^nvidia/z-ai/glm-\\d+(\\.\\d+)?$",
      "^nvidia/moonshotai/kimi-k\\d",
      "^opencode-go/glm-\\d+(\\.\\d+)?$",
      "^opencode-go/deepseek-v\\d(\\.\\d+)?-pro$",
      "^opencode-go/kimi-k\\d(\\.\\d+)?-code$",
