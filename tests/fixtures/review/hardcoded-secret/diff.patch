+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { assetUrl } from "./config";
+
+test("assetUrl encodes the key and targets the configured bucket", () => {
+  const url = assetUrl("a b/c.png");
+  assert.match(url, /^https:\/\/[^/]+\.s3\.[^/]+\.amazonaws\.com\/a%20b%2Fc\.png$/);
+});
