diff --git a/src/lib/slug.ts b/src/lib/slug.ts
--- a/src/lib/slug.ts
+++ b/src/lib/slug.ts
@@ -1,7 +1,12 @@
-export function s(t: string): string {
-  return t.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 80);
+const MAX_SLUG_LENGTH = 80;
+
+/** URL-safe slug: lowercase ASCII words joined by single dashes, at most MAX_SLUG_LENGTH chars. */
+export function slugify(title: string): string {
+  const words = title.toLowerCase().trim().replace(/[^a-z0-9]+/g, "-");
+  return words.replace(/^-|-$/g, "").slice(0, MAX_SLUG_LENGTH);
 }
