diff --git a/src/lib/slug.test.ts b/src/lib/slug.test.ts
--- a/src/lib/slug.test.ts
+++ b/src/lib/slug.test.ts
@@ -0,0 +1,19 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { slugify } from "./slug";
+
+test("slugify lowercases and joins words with single dashes", () => {
+  assert.equal(slugify("Hello,  World!"), "hello-world");
+});
+
+test("slugify trims leading and trailing dashes", () => {
+  assert.equal(slugify("--Already--"), "already");
+});
+
+test("slugify caps the length at 80 characters", () => {
+  assert.equal(slugify("a".repeat(100)).length, 80);
+});
+
+test("slugify returns an empty string for input without alphanumerics", () => {
+  assert.equal(slugify("!!!"), "");
+});
