{
	"name": "nub-ia",
	"version": "0.1.0",
	"private": true,
	"description": "Nub-IA: the Nubiral team coding-agent shell for Pi (based on gentle-shell): ODD harness with focused subagents, TDD evidence, and native review.",
	"license": "MIT",
	"type": "module",
	"bin": {
		"nub-ia": "bin/nub-ia.mjs"
	},
	"keywords": [
		"pi-package",
		"pi",
		"pi-coding-agent",
		"nub-ia",
		"odd",
		"subagents",
		"tdd",
		"code-review",
		"ai-coding-agent",
		"agent-harness"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NUBIRAL_ORG/nub-ia.git"
	},
	"files": [
		"assets/",
		"bin/",
		"docs/",
		"extensions/",
		"lib/",
		"prompts/",
		"runtime/",
		"skills/",
		"scripts/",
		"tests/",
		"!tests/fixtures/legacy/sdd-research-v2.5.0.md",
		"themes/",
		"README.md"
	],
	"scripts": {
		"postinstall": "node scripts/install-rtk.mjs",
		"test": "node scripts/run-test-suite.mjs",
		"test:harness": "node --experimental-strip-types tests/runtime-harness.mjs",
		"build:runtime-modules": "node scripts/build-runtime-modules.mjs --write",
		"check:runtime-modules": "node scripts/build-runtime-modules.mjs --check",
		"test:packed-package": "node scripts/test-packed-runner.mjs",
		"prepack": "pnpm test && pnpm run check:runtime-modules && node scripts/verify-package-files.mjs",
		"prepublishOnly": "pnpm test && pnpm run check:runtime-modules && node scripts/verify-package-files.mjs && pnpm run test:packed-package",
		"typecheck": "node scripts/check-types.mjs",
		"install:rtk": "node scripts/install-rtk.mjs"
	},
	"pi": {
		"image": "https://raw.githubusercontent.com/NUBIRAL_ORG/nub-ia/main/assets/nub-ia-logo.png",
		"extensions": [
			"./extensions"
		],
		"themes": [
			"./themes"
		],
		"prompts": [
			"./prompts"
		],
		"skills": [
			"./skills"
		]
	},
	"dependencies": {
		"@heyhuynhgiabuu/pi-pretty": "0.6.27"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.99.1",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-tui": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": ">=1.0.0",
		"@earendil-works/pi-ai": ">=1.0.0",
		"@earendil-works/pi-tui": ">=1.0.0",
		"@types/node": "^24.13.3",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "pnpm@11.1.1"
}
